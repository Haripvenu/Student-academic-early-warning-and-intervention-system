# Safe sample configuration for Academic Risk Monitor

# Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=dev-secret-key-academic-risk-monitor-2026-super-secure
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Database
# Default is local SQLite for instant zero-dependency execution.
# For Docker or PostgreSQL, set: postgresql://postgres:postgres@localhost:5432/academic_risk
DATABASE_URL=sqlite:///./academic_risk.db

# Storage & Artifacts
ARTIFACTS_DIR=./ml/artifacts
DATA_DIR=./data

# Worker & Job Configuration
JOB_LEASE_SECONDS=300
WORKER_POLL_INTERVAL=5

# ML Defaults
DEFAULT_CHECKPOINT=W4
DEMO_TERM_CODE=2025-F
ANOMALY_CORROBORATION_PERCENTILE=90.0
